generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String     @id
  name      String
  stock     Int
  purchases Purchase[]
}

model Purchase {
  id        String   @id @default(uuid())
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}
